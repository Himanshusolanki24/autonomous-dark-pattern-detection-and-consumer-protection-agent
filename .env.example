# -----------------------------------------------------------------------------
# Dark Pattern Trap Killer — Backend environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env*`.
# -----------------------------------------------------------------------------

# Public origin of the application (used for the demo target).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (NEVER expose to the browser) -------------------------------

# LLM provider key (server-side only). Used for enhanced classification.
LLM_API_KEY=
# Optional OpenAI-compatible base URL + model name.
# For Mistral AI: LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=mistral-large-latest
# For OpenAI:           LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Per-request budget (ms); a slower answer falls back to the deterministic path.
LLM_TIMEOUT_MS=20000

# Optional Neo4j knowledge graph + agent memory (sites, patterns, evidence
# phrases, runs and their steps). Run `npm run graph:seed` once. Free instance:
# https://console.neo4j.io (AuraDB) -> NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
# Local: NEO4J_URI=bolt://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Dedicated agent worker (see docs/setup/deployment.md). Server-only.
AGENT_API_URL=
AGENT_API_SECRET=

# Optional Redis for distributed queue/rate-limit. The MVP runs in-process when
# this is empty.
REDIS_URL=

# TinyFish (Search, Fetch, cloud Browser, Web Agent). Without a key everything runs locally.
TINYFISH_API_KEY=
# Public URL of the StreamVault test site; TinyFish's cloud can't reach localhost.
TINYFISH_TARGET_URL=https://autonomous-dark-pattern-detection-a.vercel.app/demo-target/account
