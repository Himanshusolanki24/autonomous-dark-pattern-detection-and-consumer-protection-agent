# -----------------------------------------------------------------------------
# Dark Pattern Trap Killer — Backend environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env*`.
# -----------------------------------------------------------------------------

# --- Public (safe for the browser) ------------------------------------------
# Project URL from Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# The Publishable key (a.k.a. anon key). Safe to expose.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of the application (used for OAuth redirects + demo target).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (NEVER expose to the browser) -------------------------------
# Service role key from Supabase dashboard. Bypasses RLS. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (server-side credential exchange).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM provider key (server-side only). Used for enhanced classification.
LLM_API_KEY=
# Optional OpenAI-compatible base URL + model name.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Dedicated agent worker (see docs/setup/deployment.md). Server-only.
AGENT_API_URL=
AGENT_API_SECRET=

# Optional Redis for distributed queue/rate-limit. The MVP runs in-process when
# this is empty.
REDIS_URL=
